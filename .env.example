# smtp | resend
EMAIL_PROVIDER=smtp

# Em desenvolvimento, use false para gerar os relatórios sem enviar e-mail.
EMAIL_SEND_ENABLED=false

# Endereço remetente. No Resend, o domínio precisa estar verificado.
EMAIL_FROM="Sebrae / MT <no-reply@exemplo.com>"

# Um ou mais destinatários administrativos separados por vírgula.
# As respostas identificam quem respondeu: envie apenas para quem consolidará a
# expectativa institucional da Diretoria.
EMAIL_RECIPIENTS=gestor1@exemplo.com,gestor2@exemplo.com
EMAIL_SUBJECT_PREFIX="[Avaliação Diretoria Sebrae / MT]"

# SMTP
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=senha-smtp

# Resend
RESEND_API_KEY=re_substitua_por_sua_chave

# Armazenamento das respostas (Vercel Blob).
# BLOB_READ_WRITE_TOKEN é injetado automaticamente ao conectar um Blob store no
# painel do Vercel. Crie o store com acesso PRIVADO: o modo de acesso não pode
# ser alterado depois da criação.
BLOB_READ_WRITE_TOKEN=

# Token da rota de exportação GET /api/respostas. Sem ele a rota fica fechada.
# Gere um valor longo e aleatório, por exemplo: openssl rand -hex 32
EXPORT_TOKEN=

# Abre GET /api/respostas sem nenhuma autenticação. Qualquer pessoa com a URL
# baixa todas as respostas da pesquisa. Só tem efeito com o valor exato "true".
# Deixe vazio ou false para exigir o EXPORT_TOKEN.
EXPORT_PUBLIC=false

# Cópias locais dos anexos para teste LOCAL apenas.
# Não funciona no Vercel: o filesystem é somente leitura e o envio falharia.
SAVE_LOCAL_REPORTS=false
LOCAL_REPORTS_DIR=.tmp/reports

# Proteção best-effort da API. Ajuste conforme o volume e a rede dos participantes.
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MINUTES=15
